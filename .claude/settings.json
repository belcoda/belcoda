{
	"hooks": {
		"SessionStart": [
			{
				"matcher": "startup|resume",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/scripts/agent-start.sh",
						"timeout": 120
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": ".claude/hooks/sonar-secrets/build-scripts/pretool-secrets.sh",
						"timeout": 60
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": ".claude/hooks/sonar-secrets/build-scripts/prompt-secrets.sh",
						"timeout": 60
					}
				]
			}
		]
	}
}
