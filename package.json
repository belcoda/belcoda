{
	"name": "belcoda",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"app:dev": "vite dev | pino-pretty -c -t",
		"app:dev:force": "vite dev --force",
		"dev": "concurrently -p \"[{name}]\" -n \"APP,ZERO\" -c \"bgMagenta.bold,bgBlue.bold\"  \"vite dev | pino-pretty -c -t\"  \"npm run zero:dev\"",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''; husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write .",
		"generate": "svelte-kit sync && drizzle-zero generate --format --output ./src/lib/zero/zero-schema.gen.ts --config ./src/lib/zero/drizzle-zero.config.ts --drizzle-kit-config ./drizzle.config.ts",
		"ngrok": "node ngrok.config.cjs",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"db:push": "drizzle-kit push",
		"db:deleteall": "npx vite-node --options.transformMode.ssr='/.*/' src/lib/server/db/seed/reset.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate-organization-settings-json": "npx vite-node --options.transformMode.ssr='/.*/' src/lib/server/db/migrate-organization-settings-json.ts",
		"db:proxy:prod": "fly proxy 15432:5432 -a belcodadb",
		"db:proxy:staging": "fly proxy 15432:5432 -a belcodadb-staging",
		"db:reset": "npm run db:deleteall && npm run db:push && npm run db:seed && npm run generate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "npx vite-node --options.transformMode.ssr='/.*/' src/lib/server/db/seed/index.ts",
		"db:seed:stress": "npx vite-node --options.transformMode.ssr='/.*/' src/lib/server/db/seed/index.ts -- --stress",
		"wuchale:extract": "wuchale --config wuchale.config.js",
		"wuchale:clean": "wuchale --config wuchale.config.js --clean",
		"zero:dev": "npx zero-cache-dev",
		"cve:check:critical": "npx cve-lite-cli --fail-on critical"
	},
	"devDependencies": {
		"@cyclonedx/cyclonedx-npm": "6.0.0",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@faker-js/faker": "^10.4.0",
		"@iconify-json/lucide": "^1.2.117",
		"@iconify/json": "^2.2.487",
		"@iconify/tailwind4": "^1.2.3",
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^1.20.0",
		"@playwright/test": "^1.61.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.69.3",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.2",
		"@types/node": "^25",
		"@types/papaparse": "^5.5.2",
		"@vitest/browser": "^4.1.10",
		"@vitest/browser-playwright": "^4.1.10",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"concurrently": "10.0.3",
		"cve-lite-cli": "^1.25.0",
		"dotenv-cli": "^11.0.0",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"formsnap": "^2.0.1",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"mode-watcher": "^1.1.0",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"playwright": "^1.61.0",
		"playwright-ctrf-json-reporter": "^0.0.29",
		"prettier": "^3.8.4",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.5",
		"svelte-check": "^4.7.2",
		"svelte-sonner": "^1.1.1",
		"sveltekit-superforms": "^2.30.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.1",
		"uuid": "^14.0.0",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^8.0.16",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.1.10",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1070.0",
		"@aws-sdk/s3-request-presigner": "^3.1087.0",
		"@better-auth/api-key": "^1.6.23",
		"@better-auth/stripe": "^1.6.23",
		"@emoji-mart/data": "^1.2.1",
		"@lexical/html": "0.40.0",
		"@openapi-contrib/json-schema-to-openapi-schema": "^4.3.4",
		"@rocicorp/zero": "1.8.0",
		"@scalar/sveltekit": "^0.3.10",
		"@sentry/sveltekit": "^10.58.0",
		"@tryghost/kg-lexical-html-renderer": "^1.4.3",
		"@types/country-list": "^2.1.4",
		"@valibot/to-json-schema": "^1.7.1",
		"@wuchale/svelte": "^0.20.0",
		"@xyflow/svelte": "^1.6.0",
		"awesome-phonenumber": "^7.8.0",
		"better-auth": "^1.6.19",
		"country-list": "^2.4.1",
		"drizzle-seed": "^0.3.1",
		"drizzle-valibot": "^0.4.2",
		"drizzle-zero": "^0.20.0",
		"emoji-mart": "^5.6.0",
		"fuse.js": "^7.4.2",
		"iso-639-1": "^3.1.5",
		"isomorphic-dompurify": "^3.17.0",
		"javascript-time-ago": "^2.6.4",
		"jwt-decode": "^4.0.0",
		"lexical": "0.48.0",
		"lru-cache": "^11.5.1",
		"melt": "^0.44.0",
		"nanoid": "^6.0.0",
		"papaparse": "^5.5.3",
		"pg-boss": "^12.19.1",
		"postgres": "^3.4.9",
		"qr": "^0.6.0",
		"stripe": "^22.3.0",
		"svelte-easy-crop": "^5.0.1",
		"svelte-lexical": "^0.6.4",
		"svelte-multiselect": "^11.8.0",
		"valibot": "^1.4.1",
		"wuchale": "^0.25.4",
		"zero-svelte": "2.0.0"
	},
	"overrides": {
		"vite-plugin-devtools-json": {
			"vite": "$vite"
		}
	}
}
